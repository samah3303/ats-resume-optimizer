{
  "name": "ResuMatch — Application Pipeline Automation",
  "nodes": [
    {
      "name": "Webhook (Status Change)",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "resumatch/application-status",
        "responseMode": "responseNode"
      }
    },
    {
      "name": "Check Status",
      "type": "n8n-nodes-base.switch",
      "position": [450, 300],
      "parameters": {
        "dataPropertyName": "status",
        "rules": [
          {"value": "interview", "output": 0},
          {"value": "offer", "output": 1},
          {"value": "rejected", "output": 2}
        ]
      }
    },
    {
      "name": "Generate Interview Prep",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 150],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/interview",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "action", "value": "start"},
            {"name": "resumeId", "value": "={{ $json.resumeId }}"},
            {"name": "jdId", "value": "={{ $json.jdId }}"}
          ]
        }
      }
    },
    {
      "name": "Email Interview Prep",
      "type": "n8n-nodes-base.emailSend",
      "position": [850, 150],
      "parameters": {
        "toEmail": "={{ $json.email }}",
        "subject": "🎯 Interview Prep — {{ $json.company }} {{ $json.title }}",
        "text": "You have an interview coming up! Here are tailored questions based on the job description:\n\n{{ $json.questions }}"
      }
    },
    {
      "name": "Generate Salary Negotiation",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 350],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/negotiate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "analysisId", "value": "={{ $json.analysisId }}"}
          ]
        }
      }
    },
    {
      "name": "Email Negotiation Guide",
      "type": "n8n-nodes-base.emailSend",
      "position": [850, 350],
      "parameters": {
        "toEmail": "={{ $json.email }}",
        "subject": "💰 Salary Negotiation Guide — {{ $json.company }}",
        "text": "Congrats on the offer! Here's your personalized negotiation guide:\n\n{{ $json }}"
      }
    },
    {
      "name": "Log Rejection",
      "type": "n8n-nodes-base.noOp",
      "position": [650, 550],
      "parameters": {}
    },
    {
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [350, 550],
      "parameters": {
        "responseBody": "={{ { success: true } }}"
      }
    }
  ],
  "connections": {
    "Webhook (Status Change)": {
      "main": [[{"node": "Check Status", "type": "main", "index": 0}]]
    },
    "Check Status": {
      "main": [
        [{"node": "Generate Interview Prep", "type": "main", "index": 0}],
        [{"node": "Generate Salary Negotiation", "type": "main", "index": 0}],
        [{"node": "Log Rejection", "type": "main", "index": 0}]
      ]
    },
    "Generate Interview Prep": {
      "main": [[{"node": "Email Interview Prep", "type": "main", "index": 0}]]
    },
    "Generate Salary Negotiation": {
      "main": [[{"node": "Email Negotiation Guide", "type": "main", "index": 0}]]
    }
  }
}
